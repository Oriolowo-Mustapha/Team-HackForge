# Base URL of the FarmHand ASP.NET Core API, reachable from the Next.js server (never exposed to browsers).
FARMHAND_API_URL=http://127.0.0.1:5037

# Set to "true" when the site is served over HTTPS so session cookies get the Secure flag.
# Defaults to true when NODE_ENV=production.
SESSION_COOKIE_SECURE=false
