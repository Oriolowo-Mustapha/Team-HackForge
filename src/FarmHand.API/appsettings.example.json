{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=FarmHandDb;Username=postgres;Password=your_password"
  },
  "Gemini": {
    "ApiKey": "your-gemini-api-key"
  },
  "Groq": {
    "ApiKey": "your-groq-api-key"
  },
  "Flutterwave": {
    "Mode": "Simulated",
    "SecretKey": "your-flutterwave-test-secret-key",
    "PublicKey": "your-flutterwave-test-public-key",
    "SigningSecret": "replace-with-a-random-signing-secret",
    "WebhookSecretHash": "replace-with-your-flutterwave-webhook-secret-hash",
    "BaseUrl": "https://api.flutterwave.com/v3",
    "RedirectUrl": "https://example.com/payment/callback"
  },
  "Brevo": {
    "Enabled": false,
    "ApiKey": "your-brevo-api-key",
    "BaseUrl": "https://api.brevo.com/v3",
    "FromAddress": "no-reply@farmhand.ai",
    "FromName": "FarmHand"
  },
  "YarnGpt": {
    "ApiKey": "your-yarngpt-api-key"
  },
  "Cloudinary": {
    "CloudName": "your-cloudinary-cloud-name",
    "ApiKey": "your-cloudinary-api-key",
    "ApiSecret": "your-cloudinary-api-secret"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_generate_a_random_secret_at_least_32_bytes",
    "Issuer": "FarmHand",
    "Audience": "FarmHandUsers",
    "ExpirationMinutes": "60"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Password": "CHANGE_ME_use_a_strong_demo_password",
    "AdminEmail": "admin@farmhand.ai",
    "FarmerEmail": "farmer@farmhand.ai",
    "VetEmail": "vet@farmhand.ai"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
