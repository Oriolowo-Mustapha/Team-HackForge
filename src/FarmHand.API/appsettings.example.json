{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=FarmHandDb;Username=postgres;Password=your_password"
  },
  "Gemini": {
    "ApiKey": "your-gemini-api-key"
  },
  "Groq": {
    "ApiKey": "your-groq-api-key"
  },
  "Nomba": {
    "Mode": "Simulated",
    "ApiKey": "your-nomba-sandbox-key",
    "SigningSecret": "replace-with-a-random-signing-secret",
    "BaseUrl": "https://sandbox.nomba.com"
  },
  "YarnGpt": {
    "ApiKey": "your-yarngpt-api-key"
  },
  "Cloudinary": {
    "CloudName": "your-cloudinary-cloud-name",
    "ApiKey": "your-cloudinary-api-key",
    "ApiSecret": "your-cloudinary-api-secret"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_generate_a_random_secret_at_least_32_bytes",
    "Issuer": "FarmHand",
    "Audience": "FarmHandUsers",
    "ExpirationMinutes": "60"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Password": "CHANGE_ME_use_a_strong_demo_password",
    "AdminEmail": "admin@farmhand.ai",
    "FarmerEmail": "farmer@farmhand.ai",
    "VetEmail": "vet@farmhand.ai"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
